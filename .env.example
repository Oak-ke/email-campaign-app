# Edgevest Campaign Manager Environment Configuration Example
PORT=3000

# Authentication & Session Security
APP_PASSWORD=your_secure_app_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=your_32_character_random_session_secret
REQUIRE_LOGIN=true

# Unsubscribe & Security Tokens
UNSUBSCRIBE_SECRET=your_32_character_unsubscribe_token_secret
REQUIRE_API_TOKEN=false
CAMPAIGN_API_TOKEN=your_optional_campaign_api_token

# Default SMTP Settings (Optional)
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASS=

# Campaign Constraints & AI
MAX_EMAILS_PER_MINUTE=30
GEMINI_API_KEY=
LOG_LEVEL=info
